<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Jumeok Yori</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>jumeok_yori</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>주변 음식점을 추천하기 위해 현재 위치를 사용합니다.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>주변 음식점을 추천하기 위해 위치 정보를 사용합니다.</string>
	<!-- 2026-08: 사진/동영상 권한 최소화 검토.
	     메뉴/가게 사진 선택은 image_picker 의 pickImage(source: gallery) 하나뿐이고,
	     내부적으로 PHPickerViewController(iOS 14+)를 사용해 사용자가 고른 사진만
	     앱에 전달되며 전체 라이브러리 접근 권한이 필요 없다. 다만 image_picker_ios
	     플러그인이 구버전 iOS 대비 PHPhotoLibrary API 를 코드 경로상 참조하고 있어,
	     이 설명 문자열 자체를 완전히 지우면 해당 API 호출 시 크래시할 위험이 있으므로
	     NSPhotoLibraryUsageDescription 은 안전장치로 유지한다. 카메라 촬영 기능은
	     앱에 없지만(ImageSource.camera 미사용) 미사용 설명 문자열은 무해하므로 유지.
	     반면 NSPhotoLibraryAddUsageDescription(사진 "저장")은 앱이 사용자 라이브러리에
	     이미지를 저장하는 기능이 전혀 없어(카메라 촬영/저장 코드 없음, grep으로 확인)
	     실제로 쓰이지 않는 권한 설명이라 제거함. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>가게 사진 등록을 위해 사진 라이브러리에 접근합니다.</string>
	<key>NSCameraUsageDescription</key>
	<string>가게 사진 촬영을 위해 카메라를 사용합니다.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>nmap</string>
	</array>
	<!-- 카카오 로그인(Supabase OAuth) 복귀용 URL Scheme.
	     Supabase Redirect URL: com.jumeokyori.app://login-callback 과 완전히 일치해야 함.
	     (실제 iOS Bundle ID는 com.jumeok.jumeokYori 그대로 유지, 이 scheme은
	     OAuth 리디렉션 전용으로 별도 등록하는 값이며 Bundle ID와 같을 필요 없음) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.jumeokyori.app.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.jumeokyori.app</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
